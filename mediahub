  var markers=document.querySelectorAll('.marker-el');
  for(var i=0;i<markers.length;i++){
    var rid=markers[i].getAttribute('data-radio');
    if(rid===selectedId)markers[i].classList.add('selected');
    else markers[i].classList.remove('selected');
  }

  // Explicit repaint for Safari and iOS WebView/Quick Look.
  var map=document.getElementById('mapWrap');
  if(map){ void map.offsetHeight; map.style.webkitTransform='translateZ(0)'; }
}
function priorityBadge(priority){var cls='priority-complementar';if(priority==='Alta')cls='priority-alta';else if(priority==='Média')cls='priority-media';return '<span class="badge '+cls+'">Prioridade '+escapeHtml(priority)+'</span>';}
function centersText(r){var centers=r.coverageCenters||[],out=[];for(var i=0;i<centers.length;i++){out.push(centers[i].label+' ('+centers[i].radiusKm+' km)');}return out.join('; ');}
function visibleRegionalRadios(){var out=[];for(var i=0;i<radios.length;i++){if(visibleRegionalRadio(radios[i]))out.push(radios[i]);}return out;}
function activeTitle(){if(regionFilter==='Nacionais'||objectiveFilter==='Campanhas nacionais')return 'Rádios nacionais';if(regionFilter==='Todas'&&objectiveFilter==='Todos')return 'Cobertura total';if(regionFilter!=='Todas'&&regionFilter!=='Regionais')return regionFilter;if(objectiveFilter!=='Todos')return objectiveFilter;return 'Rádios regionais';}
function summaryText(){if(regionFilter==='Nacionais'||objectiveFilter==='Campanhas nacionais')return 'Camada de cobertura transversal para campanhas de notoriedade e pressão comercial nacional.';if(regionFilter==='Norte')return 'O Norte concentra a maior densidade de rádios regionais, cobrindo Minho, Grande Porto, Tâmega e Sousa, Douro e Trás-os-Montes.';if(regionFilter==='Centro')return 'O Centro apresenta cobertura equilibrada entre litoral e interior, incluindo Aveiro / Ovar, Coimbra, Viseu, Guarda, Covilhã, Castelo Branco, Batalha e Caldas da Rainha.';if(regionFilter==='Lisboa e Vale do Tejo')return 'Lisboa e Vale do Tejo cobre Grande Lisboa, Margem Sul e eixo Santarém / Alverca.';if(regionFilter==='Sul')return 'O Sul tem presença seletiva em Évora e Portimão, com potencial de reforço futuro.';return 'A JOM combina cobertura nacional para notoriedade e alcance com rádios regionais para proximidade, campanhas locais e drive-to-store.';}
function renderDetail(){
  var selected=selectedId?getRadio(selectedId):null;
  if(selected&&!visibleRegionalRadio(selected))selected=null;
  if(regionFilter==='Nacionais'||objectiveFilter==='Campanhas nacionais'){var links='',sources='';for(var n=0;n<nationalRadios.length;n++){links+='<a href="'+nationalRadios[n].live+'" target="_blank" rel="noopener">Ouvir '+escapeHtml(nationalRadios[n].name)+'</a>';sources+='<p><strong>'+escapeHtml(nationalRadios[n].name)+':</strong> '+escapeHtml(nationalRadios[n].coverage)+' <a href="'+nationalRadios[n].sourceUrl+'" target="_blank" rel="noopener">Fonte</a></p>';}detail.innerHTML='<h3>Rádios Nacionais</h3><span class="badge">Portugal Continental</span><span class="badge">'+nationalRadios.length+' meios</span><p>Camada nacional para notoriedade, alcance e pressão comercial. A CM Rádio é tratada com a nuance Lisboa/Porto FM + digital.</p><div class="links">'+links+'</div><div class="section-title">Notas de cobertura</div><div class="source-list">'+sources+'</div>';return;}
  if(selected){var site=selected.site?'<a href="'+selected.site+'" target="_blank" rel="noopener">Site oficial</a>':'<span>Site por validar</span>';var live=selected.live?'<a href="'+selected.live+'" target="_blank" rel="noopener">Ouvir em direto</a>':'<span>Emissão por validar</span>';var source=selected.sourceUrl?'<a href="'+selected.sourceUrl+'" target="_blank" rel="noopener">Fonte de cobertura</a>':'';detail.innerHTML='<h3>'+escapeHtml(selected.name)+'</h3><span class="badge">Regional</span><span class="badge">'+escapeHtml(selected.region)+'</span>'+priorityBadge(selected.priority)+'<table class="table-mini"><tr><td>Zona JOM</td><td>'+escapeHtml(selected.jomZone)+'</td></tr><tr><td>Ponto no mapa</td><td>'+escapeHtml(selected.pointType)+' — '+escapeHtml(selected.city)+'</td></tr><tr><td>Frequência</td><td>'+escapeHtml(selected.frequency)+'</td></tr><tr><td>Objetivos</td><td>'+escapeHtml((selected.objectives||[]).join(', '))+'</td></tr></table><p><strong>Cobertura / influência:</strong> '+escapeHtml(selected.coverageText)+'</p><p><strong>Base usada:</strong> '+escapeHtml(selected.coverageBasis)+'</p><p><strong>Centros de cobertura no mapa:</strong> '+escapeHtml(centersText(selected))+'</p><div class="links">'+site+live+source+'</div>';return;}
  var visible=visibleRegionalRadios();detail.innerHTML='<h3>'+escapeHtml(activeTitle())+'</h3><p>'+escapeHtml(summaryText())+'</p><div class="stats"><div class="stat"><strong>'+visible.length+'</strong><span>regionais visíveis</span></div><div class="stat"><strong>'+(nationalVisible()?nationalRadios.length:0)+'</strong><span>nacionais visíveis</span></div><div class="stat"><strong>'+(showCoverage?'ON':'OFF')+'</strong><span>coberturas</span></div></div><div class="section-title">Como ler</div><p>Os círculos variam consoante a informação pública disponível: concelhos declarados, múltiplas frequências, emissores ou apenas presença local. Os rótulos podem ser ocultados para leitura mais limpa.</p>';
}
function renderList(){visibleList.innerHTML='';if(regionFilter==='Nacionais'||objectiveFilter==='Campanhas nacionais'){for(var i=0;i<nationalRadios.length;i++){(function(n){var item=document.createElement('button');item.setAttribute('type','button');item.className='list-item';item.innerHTML='<span class="bullet" style="background:var(--jom)"></span><strong>'+escapeHtml(n.name)+'</strong><small>'+escapeHtml(n.coverage)+'</small>';addEvent(item,'click',function(){window.open(n.live,'_blank');});visibleList.appendChild(item);})(nationalRadios[i]);}return;}var visible=visibleRegionalRadios();for(var j=0;j<visible.length;j++){(function(radio){var item=document.createElement('button');item.setAttribute('type','button');item.className='list-item';item.innerHTML='<span class="bullet" style="background:'+radio.color+'"></span><strong>'+escapeHtml(radio.name)+'</strong><small>'+escapeHtml(radio.zone+' · '+radio.region+' · '+radio.priority)+'</small>';addEvent(item,'click',function(){selectedId=radio.id;render();});visibleList.appendChild(item);})(visible[j]);}}
function render(){renderMapElements();renderDetail();renderList();}
function activateGroup(containerId,attrName,value){var buttons=document.getElementById(containerId).getElementsByTagName('button');for(var i=0;i<buttons.length;i++){var v=buttons[i].getAttribute(attrName);buttons[i].className=buttons[i].className.replace(/\s?active/g,'')+(v===value?' active':'');}}
function bindTap(container,handler){
  var lastTouch=0;
  addEvent(container,'touchend',function(e){
    var target=e.target;
    while(target&&target!==container&&target.tagName!=='BUTTON')target=target.parentNode;
    if(!target||target===container)return;
    lastTouch=Date.now();
    if(e.preventDefault)e.preventDefault();
    handler(target);
  });
  addEvent(container,'click',function(e){
    if(Date.now()-lastTouch<700)return;
    var target=e.target;
    while(target&&target!==container&&target.tagName!=='BUTTON')target=target.parentNode;
    if(!target||target===container)return;
    handler(target);
  });
}
function setupButtons(){
  bindTap(document.getElementById('regionControls'),function(btn){
    regionFilter=btn.getAttribute('data-region'); selectedId=null;
    activateGroup('regionControls','data-region',regionFilter); render();
  });
  bindTap(document.getElementById('objectiveControls'),function(btn){
    objectiveFilter=btn.getAttribute('data-objective'); selectedId=null;
    activateGroup('objectiveControls','data-objective',objectiveFilter); render();
  });
  bindTap(document.getElementById('markerLayer'),function(btn){
    if((' '+btn.className+' ').indexOf(' marker-el ')<0)return;
    selectedId=btn.getAttribute('data-radio'); render();
  });
  var toggleRow=document.getElementById('toggleCoverage').parentNode;
  bindTap(toggleRow,function(btn){
    if(btn.id==='toggleCoverage'){
      showCoverage=!showCoverage; btn.innerHTML=showCoverage?'Ocultar coberturas':'Mostrar coberturas'; render();
    }else if(btn.id==='toggleLabels'){
      showLabels=!showLabels; btn.innerHTML=showLabels?'Ocultar rótulos':'Mostrar rótulos'; render();
    }else if(btn.id==='toggleNorth'){
      northMode=!northMode; btn.innerHTML=northMode?'Sair do modo Norte':'Modo leitura Norte'; render();
    }
  });
  addEvent(window,'resize',function(){setTimeout(render,100);});
  addEvent(window,'orientationchange',function(){setTimeout(render,250);});
}
setupButtons();render();
</script>

<script>
(function(){
  function showPortalView(id){
    var views=document.querySelectorAll('.portal-view');
    for(var i=0;i<views.length;i++) views[i].classList.remove('active');
    var target=document.getElementById(id); if(target) target.classList.add('active');
    var nav=document.querySelectorAll('#portalNav button');
    for(var j=0;j<nav.length;j++) nav[j].classList.toggle('active',nav[j].getAttribute('data-view')===id);
    window.scrollTo(0,0);
    if(id==='radioView'){setTimeout(function(){try{render();}catch(e){}},60);}
  }

  function applyRadioPreset(t){
    var mode=t&&t.getAttribute?t.getAttribute('data-radio-mode'):null;
    if(!mode)return;
    try{
      regionFilter=(mode==='national')?'Nacionais':'Regionais';
      objectiveFilter='Todos'; selectedId=null;
      activateGroup('regionControls','data-region',regionFilter);
      activateGroup('objectiveControls','data-objective',objectiveFilter);
    }catch(e){}
  }
  function bindPortal(el){
    var lastTouch=0;
    el.addEventListener('touchend',function(e){var t=e.target.closest('[data-view],[data-open]');if(!t)return;lastTouch=Date.now();e.preventDefault();applyRadioPreset(t);showPortalView(t.getAttribute('data-view')||t.getAttribute('data-open'));},{passive:false});
    el.addEventListener('click',function(e){if(Date.now()-lastTouch<700)return;var t=e.target.closest('[data-view],[data-open]');if(!t)return;applyRadioPreset(t);showPortalView(t.getAttribute('data-view')||t.getAttribute('data-open'));});
  }
  bindPortal(document.querySelector('.portal-shell'));
  window.showPortalView=showPortalView;
})();
</script>
