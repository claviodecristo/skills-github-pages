@media(max-width:800px){.home-grid,.media-grid{grid-template-columns:1fr}.home-hero h1{font-size:32px}.portal-topbar{align-items:flex-start}.portal-nav{gap:4px}.portal-nav button{font-size:11px;padding:7px 9px}.portal-title{display:none}}
