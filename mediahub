<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>JOM Marketing Hub · Versão 1.0</title>
<style>
:root { --jom:#107C41; --jom-dark:#0B5E31; --ink:#13223A; --muted:#657387; --line:#DCE5EE; --card:#FFFFFF; }
* { box-sizing:border-box; }
html,body { margin:0; padding:0; width:100%; min-height:100%; }
body { font-family:Arial, Helvetica, sans-serif; color:var(--ink); background:#EEF6F1; }
.header { background:#fff; border-bottom:1px solid var(--line); padding:16px 18px 14px; }
.header h1 { margin:0; font-size:26px; line-height:1.15; }
.header p { margin:7px 0 0; color:var(--muted); font-size:14px; line-height:1.4; }
.controls { margin-top:13px; }
.control-row { display:block; margin:8px 0; }
.group-label { display:block; font-size:12px; font-weight:bold; color:var(--jom-dark); margin:0 0 6px; }
button { font-family:Arial, Helvetica, sans-serif; -webkit-appearance:none; appearance:none; }
.chip,.toggle { display:inline-block; margin:3px 3px 3px 0; border:1px solid #C8D7CE; background:#fff; color:var(--ink); padding:9px 12px; border-radius:20px; font-weight:bold; font-size:13px; line-height:1.1; cursor:pointer; }
.chip.active,.chip:hover { background:var(--jom); color:#fff; border-color:var(--jom); }
.toggle { border-color:var(--jom); background:rgba(16,124,65,.08); color:var(--jom-dark); }
.layout { display:block; padding:14px; }
.card { background:#fff; border:1px solid var(--line); border-radius:18px; box-shadow:0 10px 24px rgba(16,124,65,.08); }
.map-card { padding:12px; margin-bottom:14px; }
.map-top { margin-bottom:10px; }
.map-top h2 { margin:0; font-size:18px; }
.map-top small { display:block; margin-top:5px; color:var(--muted); font-size:12px; line-height:1.35; }
.legend { margin-top:9px; font-size:12px; color:var(--muted); }
.legend span { display:inline-block; margin:3px 10px 3px 0; white-space:nowrap; }
.ico { display:inline-block; vertical-align:-2px; margin-right:5px; }
.ico-dot { width:12px; height:12px; border-radius:50%; background:var(--jom); border:2px solid #fff; box-shadow:0 0 0 1px var(--jom); }
.ico-circle { width:18px; height:18px; border-radius:50%; background:rgba(16,124,65,.12); border:1px solid rgba(16,124,65,.45); }
.ico-national { width:22px; height:11px; border-radius:12px; background:rgba(16,124,65,.18); border:1px solid rgba(16,124,65,.45); }
.map-wrap { position:relative; width:100%; height:720px; min-height:520px; max-height:920px; overflow:hidden; border:1px solid #E2EAF1; border-radius:16px; background:#F8FAFC; }
.base-svg,.coverage-svg { position:absolute; left:0; top:0; width:100%; height:100%; }
.base-svg { z-index:1; }
.coverage-svg { z-index:3; pointer-events:none; }
#markerLayer { position:absolute; left:0; top:0; width:100%; height:100%; z-index:5; }
.country-shadow { fill:#DCE5ED; opacity:.55; }
.country { fill:#fff; stroke:#9DAEBD; stroke-width:2.2; }
.national-cover { fill:rgba(16,124,65,.13); stroke:rgba(16,124,65,.35); stroke-width:1.4; opacity:1; }
.water-label { fill:#8BABCB; font-size:21px; font-weight:bold; letter-spacing:2px; opacity:.43; }
.coverage-circle { fill-opacity:.13; stroke-opacity:.45; stroke-width:1.3; }
.marker { position:absolute; width:20px; height:20px; margin-left:-10px; margin-top:-10px; border:0; background:transparent; padding:0; }
.marker-pin { display:block; width:16px; height:16px; margin:2px; border-radius:50%; background:currentColor; border:3px solid #fff; box-shadow:0 0 0 1px currentColor,0 3px 8px rgba(0,0,0,.24); }
.marker.selected .marker-pin { width:20px; height:20px; margin:0; }
.label { position:absolute; min-width:116px; max-width:170px; background:rgba(255,255,255,.96); border:1px solid rgba(220,229,238,.96); border-radius:11px; padding:7px 9px; font-size:12px; line-height:1.2; box-shadow:0 8px 16px rgba(16,124,65,.08); pointer-events:none; }
.label .zone { font-weight:bold; color:var(--ink); }
.label .radio { margin-top:3px; color:var(--muted); }
.national-note { display:block; position:absolute; left:16px; bottom:16px; width:240px; max-width:calc(100% - 32px); background:rgba(255,255,255,.96); border:1px solid #D7E5DC; border-radius:13px; padding:12px; z-index:8; box-shadow:0 8px 18px rgba(16,124,65,.10); }
.national-note strong { display:block; color:var(--jom-dark); margin-bottom:5px; }
.national-note p { margin:0; font-size:12px; color:var(--muted); line-height:1.4; }
.sidebar { padding:16px; }
.detail h3 { margin:0 0 8px; font-size:21px; }
.badge { display:inline-block; padding:4px 9px; border-radius:14px; background:rgba(16,124,65,.10); color:var(--jom-dark); font-size:11px; font-weight:bold; margin:0 5px 5px 0; }
.priority-alta { background:rgba(16,124,65,.16); color:#0B5E31; }
.priority-media { background:rgba(183,121,31,.14); color:#8A5A10; }
.priority-complementar { background:rgba(101,113,135,.12); color:#465364; }
.detail p { margin:9px 0; font-size:14px; line-height:1.45; }
.stats { display:table; width:100%; border-spacing:8px; margin:10px -8px 14px; }
.stat { display:table-cell; width:33.33%; background:#F7FAF8; border:1px solid #DFECE4; border-radius:13px; padding:10px; }
.stat strong { display:block; font-size:21px; color:var(--jom-dark); }
.stat span { display:block; font-size:12px; color:var(--muted); }
.table-mini { width:100%; border-collapse:collapse; margin:12px 0; font-size:13px; }
.table-mini td { padding:7px 0; border-bottom:1px solid #EEF3F0; vertical-align:top; }
.table-mini td:first-child { width:36%; color:var(--muted); font-weight:bold; }
.links { margin-top:12px; }
.links a,.links span { display:inline-block; margin:4px 4px 4px 0; padding:9px 11px; border-radius:11px; font-size:13px; font-weight:bold; text-decoration:none; border:1px solid #D5E3D9; }
.links a { background:#fff; color:var(--jom-dark); }
.links span { background:#F4F7F5; color:#8C9B93; }
.section-title { margin:18px 0 8px; font-size:13px; font-weight:bold; text-transform:uppercase; letter-spacing:.04em; color:var(--jom-dark); }
.list { max-height:340px; overflow:auto; padding-right:2px; }
.list-item { display:block; width:100%; border:1px solid #E0EAE3; border-radius:13px; padding:10px 12px; background:#fff; cursor:pointer; margin-bottom:8px; text-align:left; }
.list-item:hover { background:#F5FBF7; }
.list-item strong { display:block; font-size:14px; }
.list-item small { display:block; color:var(--muted); margin-top:2px; line-height:1.35; }
.bullet { display:block; float:right; width:12px; height:12px; border-radius:50%; margin-top:3px; }
.note { margin-top:16px; padding:12px; border-radius:13px; background:#F7FAF8; border:1px solid #DFECE4; color:var(--muted); font-size:12px; line-height:1.45; }
.footer-note { margin-top:10px; text-align:center; font-size:12px; color:var(--muted); }
.source-list p { margin:7px 0; font-size:13px; }
.noscript { background:#fff3cd; border:1px solid #ffecb5; color:#6b4e00; padding:10px 12px; border-radius:10px; margin:10px 0; font-size:13px; }
@media (min-width:1100px) { .layout { display:table; width:100%; border-spacing:20px 0; } .main-col,.side-col { display:table-cell; vertical-align:top; } .main-col { width:calc(100% - 440px); } .side-col { width:420px; } .map-wrap { height:820px; } }
@media (max-width:600px) { .header { padding:14px 12px; } .header h1 { font-size:22px; } .layout { padding:10px; } .map-card { padding:10px; } .map-wrap { height:640px; min-height:560px; } .chip,.toggle { font-size:12px; padding:8px 10px; } .label { font-size:10px; min-width:92px; max-width:132px; padding:5px 7px; } .stats { display:block; margin:8px 0 14px; } .stat { display:block; width:100%; margin-bottom:8px; } }

/* iOS robust map-state rendering: filters are applied by CSS classes on body. */
body .coverage-el, body .marker-el, body .label-el { visibility: visible; opacity: 1; }
body.state-no-coverage .coverage-el { visibility: hidden !important; opacity: 0 !important; }
body.state-no-labels .label-el,
body.state-north-mode .label-el { display: none !important; }

body.state-region-national .coverage-el,
body.state-region-national .marker-el,
body.state-region-national .label-el { display: none !important; }

body.state-region-norte .coverage-el:not(.region-norte),
body.state-region-norte .marker-el:not(.region-norte),
body.state-region-norte .label-el:not(.region-norte),
body.state-region-centro .coverage-el:not(.region-centro),
body.state-region-centro .marker-el:not(.region-centro),
body.state-region-centro .label-el:not(.region-centro),
body.state-region-lvt .coverage-el:not(.region-lvt),
body.state-region-lvt .marker-el:not(.region-lvt),
body.state-region-lvt .label-el:not(.region-lvt),
body.state-region-sul .coverage-el:not(.region-sul),
body.state-region-sul .marker-el:not(.region-sul),
body.state-region-sul .label-el:not(.region-sul) { display: none !important; }

body.state-objective-notoriedade .coverage-el:not(.obj-notoriedade),
body.state-objective-notoriedade .marker-el:not(.obj-notoriedade),
body.state-objective-notoriedade .label-el:not(.obj-notoriedade),
body.state-objective-drive .coverage-el:not(.obj-drive),
body.state-objective-drive .marker-el:not(.obj-drive),
body.state-objective-drive .label-el:not(.obj-drive),
body.state-objective-locais .coverage-el:not(.obj-locais),
body.state-objective-locais .marker-el:not(.obj-locais),
body.state-objective-locais .label-el:not(.obj-locais),
body.state-objective-aberturas .coverage-el:not(.obj-aberturas),
body.state-objective-aberturas .marker-el:not(.obj-aberturas),
body.state-objective-aberturas .label-el:not(.obj-aberturas),
body.state-objective-national .coverage-el,
body.state-objective-national .marker-el,
body.state-objective-national .label-el { display: none !important; }

body.state-north-mode .coverage-el:not(.region-norte),
body.state-north-mode .marker-el:not(.region-norte),
body.state-north-mode .label-el:not(.region-norte) { display:none !important; }

#nationalCover { opacity:0 !important; transition:opacity .2s ease; }
#nationalNote { display:none !important; }
body.state-show-national #nationalCover { opacity:1 !important; }
body.state-show-national #nationalNote { display:block !important; }

/* Force Safari/iOS to repaint transformed map layers after state changes. */
.map-wrap, .base-svg, .coverage-svg, #markerLayer {
  -webkit-transform: translateZ(0);
  transform: translateZ(0);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

</style>

<style>
